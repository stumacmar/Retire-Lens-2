{
  "name": "retirelens-2",
  "version": "1.0.0",
  "description": "Income-first retirement planning engine for UK pensions - RetireLens Pro",
  "type": "module",
  "main": "engine/projections.js",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:engine": "node tests/engine.test.js",
    "test:modules": "node tests/newModules.test.js",
    "test:phase4": "node tests/phase4.test.js",
    "test:pathfinder": "node tests/pathfinder.test.js",
    "test:couples": "node tests/couples.test.js",
    "test:household": "node tests/householdPlan.test.js",
    "test:fixes": "node tests/fixes-validation.test.js",
    "test:nudges": "node tests/nudges.test.js",
    "test:all": "node tests/engine.test.js && node tests/newModules.test.js && node tests/phase4.test.js && node tests/pathfinder.test.js && node tests/couples.test.js && node tests/householdPlan.test.js && node tests/fixes-validation.test.js && node tests/nudges.test.js",
    "test:e2e": "npx playwright test",
    "dev": "npx http-server -p 8080 -c-1",
    "test:stress": "node tests/stress-test-100.js",
    "test:crosscheck": "node tests/beta-cross-check.js",
    "beta:excel": "node tests/generate-excel-model.js",
    "lint": "npx eslint engine/ config/ src/",
    "test:parity": "node tests/marshall-parity.js"
  },
  "keywords": [
    "retirement",
    "pension",
    "financial-planning",
    "uk-tax",
    "couples",
    "pcls",
    "household"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "jspdf": "^2.5.1",
    "html2canvas": "^1.4.1",
    "xlsx": "^0.18.5",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@playwright/test": "^1.40.0"
  }
}
